{
  "name": "vipir-palette",
  "repository": { "type": "git", "url": "git+https://github.com/vimhead/vipir-palette.git" },
  "homepage": "https://github.com/vimhead/vipir-palette#readme",
  "bugs": { "url": "https://github.com/vimhead/vipir-palette/issues" },
  "version": "0.2.0",
  "description": "Command palette plugin for vipir-editor with modal query editing and command argument completion.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent",
    "modal-editor",
    "command-palette"
  ],
  "files": [
    "extensions"
  ],
  "pi": {
    "extensions": [
      "./extensions/vipir-palette/index.ts"
    ]
  },
  "dependencies": {
    "vipir-editor": "git+https://github.com/vimhead/vipir-editor.git"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.99.1",
    "@types/node": "^26.2.0",
    "typescript": "^5.9.0",
    "@earendil-works/pi-tui": "^0.99.1"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import ./tests/loader.mjs --test tests/*.test.mjs",
    "pack:dry": "npm pack --dry-run"
  }
}
